# ADCW - AsciiDoc Container Wrapper
# Modern Ruby-based AsciiDoc toolchain for TPO42 Framework
# Base image rationale: see adr/adr-001.adoc
#
# Two images, one file, selected with --target:
#
#   buildx build --target=adoc              -t tpo42/adoc:TAG              container
#   buildx build --target=adoc-with-mermaid -t tpo42/adoc-with-mermaid:TAG container
#
# The second stage builds FROM the first rather than from a published tag, so neither
# image has to exist in a registry before the other can be built. A `FROM
# ghcr.io/tpo42/adoc:latest` would have meant that the variant could only ever be built
# against the *previous* release — and not at all on a pull request.

# ============================================================
# Stage 1: the delivered AsciiDoc toolchain
# ============================================================
FROM ruby:3-trixie AS adoc

LABEL maintainer="Jens Rehsack <rehsack+tpo42@posteo.de>"
LABEL description="AsciiDoc Container Wrapper - Lean toolchain for TPO42 operations"
LABEL version="1.0.0"

# Check for failures in piped commands
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# System environment
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ARG TZ="Etc/UTC"
ENV LC_ALL=en_US.UTF-8

# Install all required OS packages and generate the system locale
# Caching derived from example: https://docs.docker.com/reference/dockerfile/#example-cache-apt-packages
RUN --mount=type=bind,source=extra-packages,target=/mnt/extra-packages,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    export DEBIAN_FRONTEND=noninteractive \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' | tee /etc/apt/apt.conf.d/keep-cache \
    && apt-get update \
    && apt-get upgrade --yes --fix-broken --fix-missing \
    && TZ=${TZ} \
       xargs -a /mnt/extra-packages \
       apt-get install --no-install-recommends --yes locales \
    && apt-get autoremove --purge --yes \
    && update-ca-certificates \
    && sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8

# Ruby environment configuration
ENV BUNDLE_HOME=/usr/local/bundle
ENV BUNDLE_BIN=${BUNDLE_HOME}/bin
ENV BUNDLE_CACHE_PATH=${BUNDLE_HOME}/cache
ENV BUNDLE_DISABLE_PLATFORM_WARNINGS=true
ENV GEM_HOME=/usr/gem
ENV GEM_BIN_PATH=${GEM_HOME}/bin
ENV GEM_CACHE_PATH=${GEM_HOME}/cache
ENV PATH="${GEM_BIN_PATH}:$PATH"

# Install Ruby gems
RUN echo "gem: --no-ri --no-rdoc" > ~/.gemrc
# `set +o pipefail` turns off what the SHELL instruction above turned on, because
# `yes | gem …` closes the pipe early and would otherwise fail the whole RUN. hadolint
# reads this line as POSIX sh regardless of that SHELL instruction, hence the ignore —
# the option is defined in the shell this actually runs in.
# hadolint ignore=SC3040
RUN unset GEM_HOME && unset GEM_BIN \
 && set +o pipefail \
 && yes | gem update --system \
 && yes | gem install --force bundler

# Install gems for AsciiDoc toolchain. BUNDLE_GEMFILE points bundler at the mounted
# file instead of `cd`-ing to it — a WORKDIR here would have to be undone afterwards,
# and the environment variable is what bundler offers for exactly this.
RUN --mount=type=bind,source=Gemfile,target=/tmp/Gemfile,ro \
    BUNDLE_GEMFILE=/tmp/Gemfile bundle install

COPY resources/flatten.sh /usr/local/bin/flatten
COPY resources/extract-diagrams.rb /usr/local/bin/extract-diagrams
COPY resources/validate.sh /usr/local/bin/validate
RUN chmod +x /usr/local/bin/flatten /usr/local/bin/extract-diagrams /usr/local/bin/validate

# Create volume directories
ENV VOLUMES="/workspace:/build:/cache"

RUN export IFS=":" ; \
    for dir in ${VOLUMES} ; do \
        mkdir -vp "${dir}" || exit 1 ; \
    done

# Add unprivileged user with proper permissions
ARG USER_UID="1000"
ARG USER_NAME="adoc"
ARG USER_GID="100"
ARG USER_GROUP_NAME="users"

RUN ( \
        getent group "${USER_GROUP_NAME}" > /dev/null 2>&1 || \
        ( \
            ! getent group "${USER_GID}" > /dev/null 2>&1 && \
            groupadd --gid "${USER_GID}" "${USER_GROUP_NAME}" || \
            groupadd "${USER_GROUP_NAME}" \
        ) \
    ) && \
    ( \
        id -u "${USER_NAME}" > /dev/null 2>&1 || \
        useradd \
            --comment "AsciiDoc container user" \
            --uid "${USER_UID}" \
            --gid "${USER_GID}" \
            --create-home \
            --shell "/bin/bash" \
            --groups sudo \
            "${USER_NAME}" \
    ) && \
    ( \
        export IFS=":" ; \
        for dir in ${VOLUMES} ; do \
            if [ -d "${dir}" ]; then \
                chown -vhR "${USER_UID}:${USER_GID}" "${dir}" || exit 1 ; \
            fi ; \
        done \
    )

# Setup container environment
RUN --mount=type=bind,source=bashrc.bsp,target=/mnt/bashrc.bsp,ro \
    cat /mnt/bashrc.bsp >> /home/${USER_NAME}/.bashrc

# Cleanup gem caches
RUN rm -rf /home/${USER_NAME}/.gem \
    && rm -rf /root/.gem

# Switch to unprivileged user
USER ${USER_UID}
WORKDIR /workspace

# Default command: interactive shell
CMD ["/bin/bash"]

# Usage examples:
# docker run --rm -v $(pwd):/workspace ghcr.io/tpo42/adoc:latest asciidoctor mydoc.adoc
# docker run --rm -v $(pwd):/workspace ghcr.io/tpo42/adoc:latest asciidoctor-pdf mydoc.adoc
# docker run -it --rm -v $(pwd):/workspace ghcr.io/tpo42/adoc:latest bash

# ============================================================
# Stage 2: the same toolchain plus a browser, for Mermaid
#
# Mermaid renders through mermaid-cli, which drives headless Chromium through
# Puppeteer. That browser costs +1.68 GB on a 1.66 GB image, measured, so it does not
# go into stage 1: whoever does not need Mermaid does not pay for it. The pattern is
# docToolchain's doctoolchain-with-pandoc. ADR-008 carries the measurements and the two
# combinations that were tried and rejected.
#
# PlantUML with its C4 and ArchiMate libraries, Graphviz and Ditaa all come from stage 1
# and are not repeated.
# ============================================================
FROM adoc AS adoc-with-mermaid

USER 0

# Debian's chromium, not the one Puppeteer would fetch. Puppeteer ships the browser
# binary but not the GTK/ATK/X libraries it links against, so its copy aborts on a
# missing libatk-1.0.so.0 — and installing that dependency closure is precisely what
# the distribution package already does. One browser, patched by the distribution.
ENV PUPPETEER_SKIP_DOWNLOAD=1
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --no-install-recommends stays. The recommend that looks relevant, chromium-sandbox,
# costs 250 MB and makes matters worse: its SUID sandbox needs unprivileged user
# namespaces, which the container runtime's default seccomp profile refuses.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install --no-install-recommends --yes \
        chromium \
        nodejs \
        npm

RUN npm install -g @mermaid-js/mermaid-cli@11 \
    && npm cache clean --force \
    && mv /usr/local/bin/mmdc /usr/local/bin/mmdc-real

COPY resources/puppeteer.json /etc/tpo42/puppeteer.json
COPY resources/mmdc-wrapper.sh /usr/local/bin/mmdc
RUN chmod +x /usr/local/bin/mmdc

# Fail here rather than at a consumer's first diagram.
RUN mmdc --version && chromium --version

ARG USER_UID="1000"
USER ${USER_UID}
WORKDIR /workspace

CMD ["/bin/bash"]
