extends: relaxed

rules:
  line-length:
    max: 120
    level: error
    # buildx `outputs:` is one comma-separated token with nowhere to wrap, and the
    # workflow builds it from ${{ env.REGISTRY }} and ${{ env.IMAGE_NAME }} rather than
    # spelling either a second time. Shortening it would mean duplicating exactly what
    # that env block exists to hold once. The exception is named here rather than as
    # disable-line comments in the workflow, so the rule and what escapes it stay in one
    # place.
    ignore: |
      .github/workflows/container-publish.yml
