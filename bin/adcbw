#!/bin/bash
# ADCW - AsciiDoc Container Build Wrapper
# Build container with proper user mapping and error handling

set -e
set -u
set -o pipefail

# Resolve lib directory — ADOC_PROJECT_HOME (contributor/brew) or relative to this script
: "${ADOC_PROJECT_HOME:=$(realpath "$(dirname "$(dirname "${BASH_SOURCE[0]}")")")}"
_ADCW_LIB_DIR="${ADOC_PROJECT_HOME}/lib"

if [[ ! -f "${_ADCW_LIB_DIR}/adcw-common.bash" ]]; then
    echo "Error: Cannot find lib/adcw-common.bash (ADOC_PROJECT_HOME=${ADOC_PROJECT_HOME})" >&2
    exit 1
fi

# shellcheck source=../lib/adcw-common.bash
source "${_ADCW_LIB_DIR}/adcw-common.bash"

# The Containerfile carries two stages. --target is not optional here: without it the
# build produces the *last* one, which is the variant carrying a browser — 1.68 GB
# nobody asked for.
BUILD_TARGET="adoc"
IMAGE_NAME="adoc"

case "${1:-}" in
--with-mermaid)
    BUILD_TARGET="adoc-with-mermaid"
    IMAGE_NAME="adoc-with-mermaid"
    shift
    ;;
-h | --help)
    echo "Usage: adcbw [--with-mermaid]"
    echo ""
    echo "  (default)        Build adoc — the delivered toolchain"
    echo "  --with-mermaid   Build adoc-with-mermaid — the same plus a browser,"
    echo "                   roughly twice the size (ADR-008)"
    exit 0
    ;;
"") ;;
*)
    # A mistyped flag must not fall through to the default target: building the wrong
    # image while reporting success is the worst of the available answers.
    echo "Unknown option: $1" >&2
    echo "Usage: adcbw [--with-mermaid]" >&2
    exit 1
    ;;
esac

# The case above consumes at most one argument, so anything left was silently discarded
# before — `adcbw --with-mermaid --no-cache` built the variant and dropped the rest
# without a word. There is nothing here that takes a second argument, so a leftover is
# always a misunderstanding worth reporting.
if [[ $# -gt 0 ]]; then
    echo "Unexpected argument: $1" >&2
    echo "Usage: adcbw [--with-mermaid]" >&2
    exit 1
fi

# `run`, not a capability of its own. The image this produces lands in the local store of
# whichever engine builds it, and `bin/adcw` has to find it there afterwards — so the two
# must resolve the same runtime. Asking a build-specific question here could answer with
# a different engine than the run resolves, and the image would not be where it is looked
# for. See ADR-009.
_adcw_detect_runner run
# The same resolution bin/adcw performs, so the build lands under the name the run looks
# for. ADOC_IMAGE set by the caller wins on both sides, which is what makes a mirrored or
# derived image work without either wrapper knowing about it.
_adcw_resolve_image "${IMAGE_NAME}"

echo "Building ADCW Container: ${ADOC_IMAGE}"
echo "   Using: ${_ADCW_CONTAINER_RUNNER_BIN}"

# The bare verb, not `buildx build`. `buildx` is Docker's own spelling: nerdctl and
# Apple's `container` do not have it at all, podman carries it as a hidden alias onto
# `podman build`, and finch only under docker_compat where it warns and rewrites the verb.
# `build` with --build-arg, -f/--file, -t/--tag, --target and a *trailing* context path is
# present on all five (CON-001, "Build"). On docker it is not a lesser form either:
# `docker build --help` prints `Usage: docker buildx build`, so it reaches the same
# BuildKit by the same path — which is why no runtime needs a spelling of its own here.
"${_ADCW_CONTAINER_RUNNER_BIN}" build \
    --build-arg=USER_UID="$(id -u)" \
    --build-arg=USER_GID="$(id -g)" \
    --build-arg=USER_NAME="$(id -un)" \
    --build-arg=USER_GROUP_NAME="$(id -gn)" \
    --target="${BUILD_TARGET}" \
    --file "${ADOC_PROJECT_HOME}/container/Containerfile" \
    --tag="${ADOC_IMAGE}" \
    "${ADOC_PROJECT_HOME}/container"

echo "Container built successfully!"
echo ""
echo "Usage:"
echo "  ./bin/adcw shell                                           # Interactive shell"
echo "  ./bin/adcw flatten -i mydoc.adoc -o mydoc-flattened.adoc   # Flatten includes"
echo "  ./bin/adcw validate -i mydoc.adoc                          # Validate syntax"
echo ""
# Naming the store, not just the image: it is the half of the answer that decides whether
# `adcw` will find this build, and it is invisible from `adcw`'s side.
echo "Container: ${ADOC_IMAGE} (local image store of ${_ADCW_CONTAINER_RUNNER_BIN##*/})"
